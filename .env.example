# Liner Notes — required credentials. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real values.

# ── Source data: rm-playlist-v2 (read-only) ──────────────────────────────
# Convex deployment URL of the source playlist platform.
# Judge mode: leave both empty and run `npm run seed` instead — the app
# works entirely from the anonymized sample dataset.
CONVEX_SOURCE_URL=
# Deploy key scoped to `deployment:data:view` only (read-only streaming export).
# Convex dashboard → source project → Settings → Deploy keys.
CONVEX_SOURCE_DEPLOY_KEY=

# ── Liner Notes Convex deployment ────────────────────────────────────────
# Written automatically into convex/.env.local by `npx convex dev` on first run.
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# Deploy key for the Liner Notes deployment, used by the DataHub connector
# (`npx convex deployment token create <name>` from convex/, or dashboard).
CONVEX_LINER_NOTES_DEPLOY_KEY=

# ── Milestone 2+ (steward agent) ─────────────────────────────────────────
# Anthropic API key — powers the steward agent's judgment calls.
ANTHROPIC_API_KEY=
# Local DataHub GMS (the docker quickstart default). The agent's Orient phase
# reads it via the DataHub MCP Server (uvx mcp-server-datahub).
# DATAHUB_GMS_URL=http://localhost:8080
# Discogs personal access token — discogs.com → Settings → Developers.
DISCOGS_TOKEN=

# ── Milestone 5 (editorial edges) ────────────────────────────────────────
# Perplexity API key — cited music-journalism retrieval.
PERPLEXITY_API_KEY=

# SonoVault API key — optional streaming-link enrichment source.
SONOVAULT_API_KEY=
